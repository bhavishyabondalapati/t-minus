# Neon Postgres connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# MBTA V3 API key from https://api-v3.mbta.com/portal
MBTA_API_KEY="your-mbta-key-here"
# Shared secret for the scheduled reliability job (generate: openssl rand -hex 32)
CRON_SECRET="replace-with-random-hex"
# Public site URL (used by CI smoke checks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
